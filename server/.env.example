# Copy this file to server/.env and change the values. Never commit server/.env.

# Local database started by `npm run db` (or your own MongoDB / an Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/fairshare

# Signs login cookies. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=4000
